# Server options
PORT=3007
NODE_ENV=test
COOKIE_SECRET=my-secret
JWT_ACCESS_SECRET=my-access-secret
JWT_REFRESH_SECRET=my-refresh-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_test
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Adminer (database UI)
ADMINER_PORT=8081

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Application
APP_BASE_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080

# Local asset storage (profile photos)
ASSETS_DIR=./assets
ASSETS_BASE_URL=http://localhost:3007
PHOTO_MAX_SIZE_BYTES=5242880
