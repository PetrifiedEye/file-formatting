# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret
JWT_ACCESS_SECRET=my-access-secret
JWT_REFRESH_SECRET=my-refresh-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Reverse proxy: false | true | <hop count> | <comma-separated trusted IPs>
TRUST_PROXY=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Adminer (database UI)
ADMINER_PORT=8081

# Email (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Application
APP_BASE_URL=http://localhost:5174
# How often each process rebuilds its in-memory RBAC snapshot (0 disables).
RBAC_SNAPSHOT_REFRESH_MS=30000

CORS_ORIGINS=http://localhost:5174,http://localhost:4200,http://localhost:8080

# Local asset storage (profile photos)
ASSETS_DIR=./assets
ASSETS_BASE_URL=http://localhost:3007
PHOTO_MAX_SIZE_BYTES=5242880

# File format conversion
# Maximum accepted input, per detected source format
CONVERSION_MAX_BYTES_CSV=5242880
CONVERSION_MAX_BYTES_JSON=5242880
CONVERSION_MAX_BYTES_XML=5242880
CONVERSION_MAX_BYTES_YAML=5242880
# Ceiling on the produced document
CONVERSION_MAX_OUTPUT_BYTES=20971520
# Structural guards on the parsed document
CONVERSION_MAX_DEPTH=64
CONVERSION_MAX_NODES=200000
# Widest CSV output permitted (a wider header is refused, never truncated)
CONVERSION_MAX_CSV_COLUMNS=1024
# Per-conversion wall-clock budget
CONVERSION_TIMEOUT_MS=10000
# Concurrent conversions. Bounds peak memory, not latency.
CONVERSION_MAX_CONCURRENT=4
# Retained-result root. NOT ASSETS_DIR: that tree is served unauthenticated.
CONVERSION_STORAGE_DIR=./storage/conversions

# Image conversion
# Maximum accepted input, per detected source format. SVG's is tightest: a few
# KiB of markup can demand gigabytes of pixels.
IMAGE_MAX_BYTES_PNG=10485760
IMAGE_MAX_BYTES_JPEG=10485760
IMAGE_MAX_BYTES_SVG=2097152
# Largest rasterisation permitted, checked before the renderer is constructed
IMAGE_MAX_OUTPUT_WIDTH=8192
IMAGE_MAX_OUTPUT_HEIGHT=8192
# Decoded pixel budget, read from the container header before any allocation
IMAGE_MAX_PIXELS=16000000
# Ceiling on the produced image
IMAGE_MAX_OUTPUT_BYTES=20971520
# What transparency is composited onto, and what an SVG is rasterised over
IMAGE_BACKGROUND_COLOR=#ffffff
# Fixed output quality for JPEG. Never caller-supplied.
IMAGE_JPEG_QUALITY=85
# Per-conversion wall-clock budget
IMAGE_CONVERSION_TIMEOUT_MS=30000
# Concurrent image conversions. Lower than the text pipeline's: a decoded
# raster is far larger relative to its upload than a parsed document is.
IMAGE_MAX_CONCURRENT=2
# Fonts for SVG rasterisation. Empty means no fonts at all, so <text> renders
# as nothing -- deliberate, so output is reproducible across hosts.
IMAGE_SVG_FONT_DIR=
